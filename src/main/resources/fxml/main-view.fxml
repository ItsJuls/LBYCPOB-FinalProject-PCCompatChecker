<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<!--AnchorPane is being used as our main canvas.-->
<!--This makes it easier to position controls manually-->
<!--in Scene Builder while we are designing the UI.-->

<AnchorPane prefHeight="810.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pccompatchecker.controller.MainController">

    <Label layoutX="301.0" layoutY="44.0" text="PC COMPATIBILITY CHECKER">
      <font>
         <Font size="28.0" />
      </font></Label>

    <Label layoutX="406.0" layoutY="84.0" text="PC BUILDER">
      <font>
         <Font size="28.0" />
      </font></Label>

    <!-- CPU -->
    <Label layoutX="19.0" layoutY="158.0" text="CPU" />

    <ComboBox fx:id="cpuCBox" layoutX="19.0" layoutY="183.0" prefWidth="400.0" promptText="Select CPU" />

    <!-- Motherboard -->
    <Label layoutX="19.0" layoutY="238.0" text="Motherboard" />

    <ComboBox fx:id="moboCBox" layoutX="19.0" layoutY="263.0" prefWidth="400.0" promptText="Select Motherboard" />

    <!-- RAM -->
    <Label layoutX="19.0" layoutY="318.0" text="RAM" />

    <ComboBox fx:id="ramCBox" layoutX="19.0" layoutY="343.0" prefWidth="400.0" promptText="Select RAM" />

    <!-- GPU -->
    <Label layoutX="19.0" layoutY="398.0" text="GPU" />

    <ComboBox fx:id="gpuCBox" layoutX="19.0" layoutY="423.0" prefWidth="400.0" promptText="Select GPU" />

    <!-- Storage -->
    <Label layoutX="19.0" layoutY="478.0" text="Storage" />

    <ComboBox fx:id="storageCBox" layoutX="19.0" layoutY="503.0" prefWidth="400.0" promptText="Select Storage" />

    <!-- CPU Cooler -->
    <Label layoutX="19.0" layoutY="558.0" text="CPU Cooler" />

    <ComboBox fx:id="coolerCBox" layoutX="19.0" layoutY="583.0" prefWidth="400.0" promptText="Select CPU Cooler" />

    <!-- PSU -->
    <Label layoutX="19.0" layoutY="638.0" text="PSU" />

    <ComboBox fx:id="psuCBox" layoutX="19.0" layoutY="663.0" prefWidth="400.0" promptText="Select PSU" />

    <!-- Case -->
    <Label layoutX="19.0" layoutY="718.0" text="Case" />

    <ComboBox fx:id="caseCBox" layoutX="19.0" layoutY="743.0" prefWidth="250.0" promptText="Select Case" />

    <!-- Budget -->
    <Label layoutX="469.0" layoutY="158.0" text="Budget" />

    <Slider fx:id="budgetSlider" layoutX="469.0" layoutY="188.0" max="500000" min="0" prefWidth="250.0" value="25000" />

    <Label fx:id="budgetValueLabel" layoutX="469.0" layoutY="218.0" text="₱25,000" />

    <!-- Compatibility -->
    <Button fx:id="compatibilityButton" layoutX="469.0" layoutY="311.0" onAction="#compatibilityCheck" text="Check Compatibility" />

    <!-- Compatibility Results -->
    <Label layoutX="469.0" layoutY="401.0" text="COMPATIBILITY RESULTS" />

    <TextArea fx:id="resultsTextArea" editable="false" layoutX="469.0" layoutY="431.0" prefHeight="342.0" prefWidth="473.0" wrapText="true" />

</AnchorPane>
