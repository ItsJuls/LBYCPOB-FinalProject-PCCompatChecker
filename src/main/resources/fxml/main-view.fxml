<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>

<!--AnchorPane is being used as our main canvas.-->
<!--This makes it easier to position controls manually-->
<!--in Scene Builder while we are designing the UI.-->

<AnchorPane prefHeight="700.0" prefWidth="752.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pccompatchecker.controller.MainController">

    <Label text="PC COMPATIBILITY CHECKER"
           layoutX="400.0"
           layoutY="30.0"/>

    <Label text="BUILD"
           layoutX="40.0"
           layoutY="100.0"/>

    <Button text="Dashboard"
            layoutX="30.0"
            layoutY="140.0"/>

    <Button text="PC Builder"
            layoutX="30.0"
            layoutY="190.0"/>

    <Button text="Compatibility"
            layoutX="30.0"
            layoutY="240.0"/>

    <Button text="Summary"
            layoutX="30.0"
            layoutY="290.0"/>

    <Label text="PC BUILDER"
           layoutX="300.0"
           layoutY="100.0"/>

    <!-- CPU -->
    <Label text="CPU"
           layoutX="300.0"
           layoutY="150.0"/>

    <ComboBox promptText="Select CPU"
              layoutX="300.0"
              layoutY="175.0"
              prefWidth="400.0"/>

    <!-- Motherboard -->
    <Label text="Motherboard"
           layoutX="300.0"
           layoutY="230.0"/>

    <ComboBox promptText="Select Motherboard"
              layoutX="300.0"
              layoutY="255.0"
              prefWidth="400.0"/>

    <!-- RAM -->
    <Label text="RAM"
           layoutX="300.0"
           layoutY="310.0"/>

    <ComboBox promptText="Select RAM"
              layoutX="300.0"
              layoutY="335.0"
              prefWidth="400.0"/>

    <!-- GPU -->
    <Label text="GPU"
           layoutX="300.0"
           layoutY="390.0"/>

    <ComboBox promptText="Select GPU"
              layoutX="300.0"
              layoutY="415.0"
              prefWidth="400.0"/>

    <!-- Storage -->
    <Label text="Storage"
           layoutX="300.0"
           layoutY="470.0"/>

    <ComboBox promptText="Select Storage"
              layoutX="300.0"
              layoutY="495.0"
              prefWidth="400.0"/>

    <!-- Budget -->
    <Label text="Budget"
           layoutX="750.0"
           layoutY="150.0"/>

    <Slider min="0"
            max="50000"
            value="25000"
            layoutX="750.0"
            layoutY="180.0"
            prefWidth="250.0"/>

    <!-- Compatibility -->
    <Button text="Check Compatibility"
            layoutX="750.0"
            layoutY="250.0"/>

   <Line endX="11.0" endY="472.29290771484375" layoutX="161.0" layoutY="232.0" startX="11.0" startY="-232.0" />

</AnchorPane>
