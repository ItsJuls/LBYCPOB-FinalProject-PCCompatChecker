<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.controlsfx.control.*?>

<!--AnchorPane is being used as our main canvas.-->
<!--This makes it easier to position controls manually-->
<!--in Scene Builder while we are designing the UI.-->
<!--ScrollPane wraps the AnchorPane so the form is still reachable-->
<!--on smaller/lower-resolution screens where the content would-->
<!--otherwise be clipped at the bottom.-->

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pccompatchecker.controller.MainController">
<content>
<AnchorPane prefHeight="810.0" prefWidth="960.0">

    <Label layoutX="301.0" layoutY="44.0" text="PC COMPATIBILITY CHECKER">
      <font>
         <Font size="28.0" />
      </font></Label>

    <Label layoutX="406.0" layoutY="84.0" text="PC BUILDER">
      <font>
         <Font size="28.0" />
      </font></Label>

    <!-- CPU -->
    <Label layoutX="19.0" layoutY="158.0" text="CPU" />

    <SearchableComboBox fx:id="cpuCBox" layoutX="19.0" layoutY="183.0" prefWidth="350.0" promptText="Select CPU" />
    <Button fx:id="cpuFilterButton" layoutX="377.0" layoutY="183.0" prefWidth="55.0" text="Filter" />

    <!-- Motherboard -->
    <Label layoutX="19.0" layoutY="238.0" text="Motherboard" />

    <SearchableComboBox fx:id="moboCBox" layoutX="19.0" layoutY="263.0" prefWidth="350.0" promptText="Select Motherboard" />
    <Button fx:id="moboFilterButton" layoutX="377.0" layoutY="263.0" prefWidth="55.0" text="Filter" />

    <!-- RAM -->
    <Label layoutX="19.0" layoutY="318.0" text="RAM" />

    <SearchableComboBox fx:id="ramCBox" layoutX="19.0" layoutY="343.0" prefWidth="350.0" promptText="Select RAM" />
    <Button fx:id="ramFilterButton" layoutX="377.0" layoutY="343.0" prefWidth="55.0" text="Filter" />

    <!-- GPU -->
    <Label layoutX="19.0" layoutY="398.0" text="GPU" />

    <SearchableComboBox fx:id="gpuCBox" layoutX="19.0" layoutY="423.0" prefWidth="350.0" promptText="Select GPU" />
    <Button fx:id="gpuFilterButton" layoutX="377.0" layoutY="423.0" prefWidth="55.0" text="Filter" />

    <!-- Storage -->
    <Label layoutX="19.0" layoutY="478.0" text="Storage" />

    <SearchableComboBox fx:id="storageCBox" layoutX="19.0" layoutY="503.0" prefWidth="350.0" promptText="Select Storage" />
    <Button fx:id="storageFilterButton" layoutX="377.0" layoutY="503.0" prefWidth="55.0" text="Filter" />

    <!-- CPU Cooler -->
    <Label layoutX="19.0" layoutY="558.0" text="CPU Cooler" />

    <SearchableComboBox fx:id="coolerCBox" layoutX="19.0" layoutY="583.0" prefWidth="350.0" promptText="Select CPU Cooler" />
    <Button fx:id="coolerFilterButton" layoutX="377.0" layoutY="583.0" prefWidth="55.0" text="Filter" />

    <!-- PSU -->
    <Label layoutX="19.0" layoutY="638.0" text="PSU" />

    <SearchableComboBox fx:id="psuCBox" layoutX="19.0" layoutY="663.0" prefWidth="350.0" promptText="Select PSU" />
    <Button fx:id="psuFilterButton" layoutX="377.0" layoutY="663.0" prefWidth="55.0" text="Filter" />

    <!-- Case -->
    <Label layoutX="19.0" layoutY="718.0" text="Case" />

    <SearchableComboBox fx:id="caseCBox" layoutX="19.0" layoutY="743.0" prefWidth="200.0" promptText="Select Case" />
    <Button fx:id="caseFilterButton" layoutX="227.0" layoutY="743.0" prefWidth="55.0" text="Filter" />

    <!-- Budget -->
    <Label layoutX="469.0" layoutY="158.0" text="Budget" />

    <Slider fx:id="budgetSlider" layoutX="469.0" layoutY="188.0" max="500000" min="0" prefWidth="250.0" value="250000" />

    <TextField fx:id="budgetInput" layoutX="730.0" layoutY="178.0" prefWidth="120.0" promptText="Enter budget" />

    <!-- Remaining Budget -->
    <Label fx:id="budgetValueLabel" layoutX="469.0" layoutY="218.0" text="Budget: ₱0" />
    <Label fx:id="totalSpentLabel" layoutX="469.0" layoutY="235.0" text="Total Spent: ₱0" />
    <Label fx:id="remainingBudgetLabel" layoutX="469.0" layoutY="252.0" text="Remaining: ₱0" />

    <!-- Compatibility -->
    <Button fx:id="compatibilityButton" layoutX="470.0" layoutY="368.0" onAction="#compatibilityCheck" text="Check Compatibility" />

    <!-- Compatibility Results -->
    <Label layoutX="470.0" layoutY="398.0" text="COMPATIBILITY RESULTS" />

    <TextArea fx:id="resultsTextArea" editable="false" layoutX="469.0" layoutY="431.0" prefHeight="342.0" prefWidth="473.0" wrapText="true" />

</AnchorPane>
</content>
</ScrollPane>
